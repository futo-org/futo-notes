# Xcode build output
.build/
.build-device/
.build-device-release/
.build-release-compliance/
DerivedData/

# Generated by xcodegen (regenerate via: xcodegen generate)
*.xcodeproj/

# The retired web editor bundle, which older checkouts still hold (2.3 MB).
# Nothing builds or loads it; project.yml excludes it from the app. Delete it.
Resources/editor.html
Resources/*.lproj/InfoPlist.strings
Resources/.generated-language-directories.json
Resources/LanguageCatalogs.json
Sources/GeneratedLocalization/

# Rust UniFFI core build artifacts (regenerate via build-rust-ios.sh):
# the xcframework (static libs) and the generated Swift bindings.
*.xcframework/
Sources/Generated/
