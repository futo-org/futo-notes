<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sync talks to the E2EE server over HTTP(S). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- DEVICE storage mode [app.md]: keeps the vault in a shared folder
         (Documents/FUTO Notes) the user can open in the Files app + sync with
         other apps. The Rust core does direct std::fs path I/O, so SAF/content
         URIs are not viable; broad access is the only way to a user-visible,
         path-addressable vault (same reason Obsidian declares this). It is a
         user-granted "All files access" special permission (Settings), never an
         install-time grant; APP storage is the no-permission alternative. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Cleartext HTTP is permitted in all build types (usesCleartextTraffic
         below) so self-hosters and testers can point at a plain-http:// server
         (a LAN box or a VPS without TLS). Note content is E2EE-encrypted
         client-side before upload, so the transport carries only opaque blobs +
         auth. HTTPS is still recommended; this only removes the OS-level block
         on http://. -->

    <!-- Deliberately NO android:roundIcon. minSdk 28 means every supported
         device resolves android:icon to the adaptive icon
         (mipmap-anydpi-v26/ic_launcher.xml) and applies its own launcher mask,
         including the round one. There is no mipmap-anydpi-v26/ic_launcher_round
         variant, so declaring roundIcon pointed launchers that prefer it at the
         flat legacy bitmap instead: that bitmap carries the adaptive layer's
         18dp bleed margin, so the mark filled only ~53% of it, and the launcher
         then normalized and circle-masked it again — the mark rendered about
         half the size it should. Reported on 1.6.1; it broke in 1.5.5, when the
         regenerated round bitmap lost the transparent corners that had made it
         genuinely round. Do not re-add roundIcon without also adding an adaptive
         mipmap-anydpi-v26/ic_launcher_round.xml. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar"
        android:usesCleartextTraffic="true">
        <!-- singleTop so a `futonotes://` link delivered while the app is
             already running arrives at the LIVE activity via onNewIntent,
             instead of stacking a second MainActivity that would re-run the
             whole startup (a second NotesStore over the same vault). This is
             the only activity, so it is always the top of the task. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The `futonotes` URL scheme (docs/spec/license.md § Deep link).
                 FUTOpay's activate-redirect page opens
                 futonotes://license/{key}/{activation}; BROWSABLE is what lets
                 a browser hand it over.

                 Scheme only, deliberately: no android:host="license". Which
                 links this app defines is the CRATE's verdict
                 (`licenseHandleDeepLink` → parse_deep_link), on all three
                 platforms — a host filter here would move half of that rule
                 into the manifest, where no test of the Rust rules can see it,
                 and the two halves would then have to be kept in step by hand.
                 Everything the crate does not define is ignored silently, which
                 is exactly what the spec asks for. iOS registers the same way
                 (CFBundleURLSchemes carries the scheme, nothing else).

                 LicenseSurfaceTest asserts this filter answers the crate's
                 licenseDeepLinkScheme(), so a manifest that lost it fails
                 rather than silently never receiving a link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="futonotes" />
            </intent-filter>
        </activity>

        <!-- Camera capture target for the editor's pickImage flow: TakePicture
             writes into a cache file exposed via this provider. No CAMERA
             permission needed — the system camera app does the capturing. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
