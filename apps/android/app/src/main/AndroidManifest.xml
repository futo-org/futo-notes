<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sync talks to the E2EE server over HTTP(S). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- DEVICE storage mode [app.md]: keeps the vault in a shared folder
         (Documents/FUTO Notes) the user can open in the Files app + sync with
         other apps. The Rust core does direct std::fs path I/O, so SAF/content
         URIs are not viable; broad access is the only way to a user-visible,
         path-addressable vault (same reason Obsidian declares this). It is a
         user-granted "All files access" special permission (Settings), never an
         install-time grant; APP storage is the no-permission alternative. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Cleartext HTTP is permitted in all build types (usesCleartextTraffic
         below) so self-hosters and testers can point at a plain-http:// server
         (a LAN box or a VPS without TLS). Note content is E2EE-encrypted
         client-side before upload, so the transport carries only opaque blobs +
         auth. HTTPS is still recommended; this only removes the OS-level block
         on http://. -->

    <!-- Reading a pairing QR code on an already-unlocked device (ADR 0003
         decision 5). Requested at the moment of use, on the scanner screen and
         nowhere else; a refusal is not a dead end, because the device being set
         up can still be unlocked by typing the vault password. The editor's
         image capture still needs NO camera permission — it hands off to the
         system camera app (see the FileProvider below). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Not required: a device with no camera installs fine and is told so on
         the scanner screen. It can still SHOW a code for another device. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Package visibility (Android 11+): without this, CustomTabsClient's own
         service query comes back empty on a targetSdk 30+ build, so the hosted
         sign-in silently takes its ACTION_VIEW fallback on EVERY device — a
         plain browser window instead of a tab over the app. androidx.browser
         does not contribute this entry; the app must declare it. Found by
         reading dumpsys after a real run, where every open landed in
         ChromeTabbedActivity rather than a Custom Tab. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!-- Deliberately NO android:roundIcon. minSdk 28 means every supported
         device resolves android:icon to the adaptive icon
         (mipmap-anydpi-v26/ic_launcher.xml) and applies its own launcher mask,
         including the round one. There is no mipmap-anydpi-v26/ic_launcher_round
         variant, so declaring roundIcon pointed launchers that prefer it at the
         flat legacy bitmap instead: that bitmap carries the adaptive layer's
         18dp bleed margin, so the mark filled only ~53% of it, and the launcher
         then normalized and circle-masked it again — the mark rendered about
         half the size it should. Reported on 1.6.1; it broke in 1.5.5, when the
         regenerated round bitmap lost the transparent corners that had made it
         genuinely round. Do not re-add roundIcon without also adding an adaptive
         mipmap-anydpi-v26/ic_launcher_round.xml. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Camera capture target for the editor's pickImage flow: TakePicture
             writes into a cache file exposed via this provider. No CAMERA
             permission needed — the system camera app does the capturing. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
