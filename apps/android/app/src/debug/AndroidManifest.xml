<?xml version="1.0" encoding="utf-8"?>
<!-- Lets simpleperf attach to the non-debuggable keystroke-latency build (futoEditorPerf). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <profileable android:shell="true" tools:targetApi="29" />
        <activity
            android:name=".textfirst.TextFirstToolbarTestActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|locale|layoutDirection"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
