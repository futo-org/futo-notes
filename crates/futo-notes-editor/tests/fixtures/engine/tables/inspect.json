  "before": "| a |\n|---|\nb‸ | c",
  "inspect": null
 },
 {
  "name": "inspect_tables finds every table in the note, each once",
  "before": "‸| a |\n|---|\n| b |\n\ntext | not a table\n\n| x | y |\n|---|---|\n| 1 | 2 | 3 |\n| 4 |",
