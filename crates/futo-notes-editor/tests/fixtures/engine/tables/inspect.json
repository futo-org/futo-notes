 {
  "name": "a table row needs a leading pipe",
  "before": "a‸ | b\n--- | ---\n1 | 2",
  "inspect": null
 },
 {
  "name": "tables are read only at the top level: not in a quote",
  "before": "> | a‸ |\n> |---|",
  "inspect": null
 },
 {
  "name": "tables are read only at the top level: not in a list",
  "before": "- | a‸ |\n  |---|",
  "inspect": null
 },
 {
  "name": "tables are read only at the top level: not indented",
  "before": "  | a‸ |\n  |---|",
  "inspect": null
 },
 {
  "name": "a table in a code block is code",
  "before": "```\n| a‸ |\n|---|\n```",
