[
 {
  "name": "cells show in the note's display, with alignment, and an escaped pipe stays in its cell",
  "before": "‸| **a** | b\\|c |\n|:--|--:|\n| x |\n\npara",
  "inspect": {
   "columns": 2,
   "alignments": [
    "Left",
    "Right"
   ],
   "rows": [
    [
     "a",
     "b|c"
    ],
    [
     "x"
    ]
   ],
   "focus": null,
   "lines": [
    "| a | b|c |",
    "| x |"
   ],
   "delimiter": "|:--|--:|"
  }
 },
 {
  "name": "a caret in a header cell focuses it; the header cannot be deleted or have a row above it",
  "before": "| a‸ | b |\n|---|---|\n| c | d |",
  "inspect": {
   "columns": 2,
   "alignments": [
    "None",
    "None"
   ],
   "rows": [
    [
     "a",
     "b"
    ],
    [
     "c",
     "d"
    ]
   ],
   "focus": [
    0,
    0
   ],
   "controls": [
    "below",
    "left",
    "right",
    "delete column"
   ]
  }
 },
 {
  "name": "the only body row cannot be deleted; a single column cannot be deleted",
