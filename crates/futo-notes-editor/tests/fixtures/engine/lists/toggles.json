  "after": "1. a\n2. ‸b\n3. c"
 },
 {
  "name": "Numbered above a first item bumps it",
  "before": "‸a\n1. b",
  "command": "OrderedList",
  "after": "1. ‸a\n2. b"
 },
 {
  "name": "Numbered leaves an item below that was not counting on",
