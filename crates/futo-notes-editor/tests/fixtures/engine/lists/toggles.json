  "after": "- item 1\n‸item 2\n- item 3"
 },
 {
  "name": "Two runs of bullets stay as typed",
  "before": "- a\n‸b\n* c",
  "command": "BulletList",
  "after": "- a\n- ‸b\n* c"
 },
 {
  "name": "Numbered on plain lines counts from 1",
