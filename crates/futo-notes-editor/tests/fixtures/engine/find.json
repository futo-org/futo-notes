[
  {"name": "case-insensitive literal, no word rules", "before": "Concatenate CAT cat", "command": {"find": "cat"}, "after": {"matches": ["cat", "CAT", "cat"], "current": 1, "source": "cat"}},
  {"name": "a trailing space is part of the query", "before": "Aug 3 and August", "command": {"find": "Aug "}, "after": {"matches": ["Aug "]}},
  {"name": "visible text spans hidden bold markers", "before": "a **bo**ld *x*", "command": {"find": "bold"}, "after": {"matches": ["bold"], "current": 1, "source": "bo**ld"}},
  {"name": "hidden markers are not findable", "before": "a **bo**ld", "command": {"find": "**"}, "after": {"matches": []}},
  {"name": "inline code text is findable", "before": "see [t](http://u) `co`", "command": {"find": "co"}, "after": {"matches": ["co"], "source": "co"}},
  {"name": "a link destination is hidden", "before": "see [t](http://u)", "command": {"find": "http"}, "after": {"matches": []}},
  {"name": "a link label maps to its source", "before": "see [the cat](http://u)", "command": {"find": "the cat"}, "after": {"matches": ["the cat"], "source": "the cat"}},
  {"name": "two plain lines are two lines", "before": "hey man\nyes\n\nz", "command": {"find": "man yes"}, "after": {"matches": []}},
  {"name": "two quote lines are two lines", "before": "> hey man\n> yes", "command": {"find": "man yes"}, "after": {"matches": []}},
  {"name": "an indented line under a bullet is its own line", "before": "- a\n  man\n  yes", "command": {"find": "man yes"}, "after": {"matches": []}},
  {"name": "a blank line is a barrier", "before": "one\n\ntwo", "command": {"find": "one two"}, "after": {"matches": []}},
  {"name": "list items are barriers", "before": "- a\n- b", "command": {"find": "a b"}, "after": {"matches": []}},
  {"name": "a heading edge is a barrier", "before": "# h\nb", "command": {"find": "h b"}, "after": {"matches": []}},
  {"name": "code lines are barriers", "before": "```\nx\ny\n```", "command": {"find": "x y"}, "after": {"matches": []}},
  {"name": "code text is findable", "before": "```\nlet Foo;\n```", "command": {"find": "foo"}, "after": {"matches": ["Foo"], "source": "Foo"}},
  {"name": "a list marker is hidden", "before": "- milk\n- more milk", "command": {"find": "- m"}, "after": {"matches": []}},
  {"name": "a list item's text maps past its marker", "before": "- milk\n  - more milk", "command": {"find": "milk"}, "after": {"matches": ["milk", "milk"], "current": 1, "source": "milk"}},
  {"name": "a heading marker is hidden", "before": "# Title", "command": {"find": "# t"}, "after": {"matches": []}},
  {"name": "a table cell is findable", "before": "| a | Bee |\n|---|---|\n| c | d |", "command": {"find": "bee"}, "after": {"matches": ["Bee"], "source": "Bee"}},
  {"name": "a pipe between cells is a barrier", "before": "| a | b |\n|---|---|\n| c | d |", "command": {"find": "a | b"}, "after": {"matches": []}},
  {"name": "rows are barriers", "before": "| a | b |\n|---|---|\n| c | d |", "command": {"find": "b c"}, "after": {"matches": []}},
  {"name": "pipes are not findable in a table", "before": "| a | b |\n|---|---|\n| c | d |", "command": {"find": "|"}, "after": {"matches": []}},
  {"name": "the delimiter row is not findable", "before": "| a | b |\n|---|---|\n| c | d |", "command": {"find": "---"}, "after": {"matches": []}},
  {"name": "an escaped pipe is cell text", "before": "x\n\n| a\\|b | y |\n|---|---|\n\nx | y", "command": {"find": "a|b"}, "after": {"matches": ["a|b"], "source": "a\\|b"}},
  {"name": "a pipe line with no delimiter row is plain", "before": "| a | b |\n| c | d |", "command": {"find": "a | b"}, "after": {"matches": ["a | b"]}},
  {"name": "a row with no leading pipe is plain", "before": "x\n\n| a | y |\n|---|---|\n\nx | y", "command": {"find": "x | y"}, "after": {"matches": ["x | y"]}},
  {"name": "cells past the header are findable", "before": "| a |\n|---|\n| b | extra |", "command": {"find": "extra"}, "after": {"matches": ["extra"]}},
  {"name": "bold left open is literal text", "before": "**not\nbold**", "command": {"find": "**"}, "after": {"matches": ["**", "**"]}},
  {"name": "an escaped character is found, its backslash is not", "before": "\\*a\\*", "command": {"find": "*a*"}, "after": {"matches": ["*a*"], "source": "\\*a\\*"}},
  {"name": "every sigma is one letter", "before": "ΟΔΟΣΑ οδος", "command": {"find": "οδοσ"}, "after": {"matches": ["ΟΔΟΣ", "οδος"]}},
  {"name": "a letter with a longer lowercase matches only itself", "before": "İi", "command": {"find": "i"}, "after": {"matches": ["i"]}},
  {"name": "the whole text matches", "before": "abab", "command": {"find": "abab"}, "after": {"matches": ["abab"]}},
  {"name": "matches never overlap", "before": "aaaa", "command": {"find": "aa"}, "after": {"matches": ["aa", "aa"]}},
  {"name": "an empty query finds nothing", "before": "anything", "command": {"find": ""}, "after": {"matches": []}},
  {"name": "a query with a line break finds nothing", "before": "a\nb", "command": {"find": "a\nb"}, "after": {"matches": []}},
  {"name": "front matter is not findable", "before": "---\ntitle: cat\n---\ncat", "command": {"find": "cat"}, "after": {"matches": ["cat"], "current": 1, "source": "cat"}},
  {"name": "a lone first-line divider is not front matter", "before": "---\ncat", "command": {"find": "cat"}, "after": {"matches": ["cat"]}},
  {"name": "a divider is not findable", "before": "a\n\n---\n\ncat ---", "command": {"find": "￼"}, "after": {"matches": []}},
  {"name": "the current match is the first at or after the caret", "before": "x one\nX two\n\nx **th**ree", "at": 3, "command": {"find": "x"}, "after": {"matches": ["x", "X", "x"], "current": 2, "source": "X"}},
  {"name": "past the last match the current one wraps to the first", "before": "cat dog", "at": 5, "command": {"find": "cat"}, "after": {"matches": ["cat"], "current": 1}},
  {"name": "a match across a hidden mark maps to tight source", "before": "x **th**ree", "command": {"find": "three"}, "after": {"matches": ["three"], "current": 1, "source": "th**ree"}},
  {"name": "a match ending at a closing mark stops before it", "before": "**cat** dog", "command": {"find": "cat"}, "after": {"matches": ["cat"], "source": "cat"}},
  {"name": "a match inside a quote maps past its marker", "before": "> > deep cat", "command": {"find": "deep"}, "after": {"matches": ["deep"], "source": "deep"}},
  {"name": "a CRLF line break is a barrier", "before": "a\r\nb", "command": {"find": "a b"}, "after": {"matches": []}},
  {"name": "a query holding a CR finds nothing", "before": "a\rb", "command": {"find": "a\rb"}, "after": {"matches": []}}
]
