        "do": "Complete:Projects/Roadmap",
        "after": "see [[Projects/Roadmap]]^"
      }
    ]
  },
  {
    "name": "(10) a ] typed with Code carried at a link's text end lands in the code span after the link",
    "before": "[t^](u)`]`",
    "marks": "^{}",
    "steps": [
