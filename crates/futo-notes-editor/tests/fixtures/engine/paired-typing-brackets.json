    "marks": "^{}",
    "steps": [
      {
        "do": "pair:]",
        "after": "see [[Ro]^] x"
      },
      {
        "do": "pair:]",
        "after": "see [[Ro]]^ x"
      }
    ]
  },
  {
    "name": "(9) a task item typed: - [ ] then a space",
    "before": "- ^",
    "marks": "^{}",
    "steps": [
      {
        "do": "pair:[",
        "after": "- [^]"
      },
      {
        "do": "type: ",
        "after": "- [ ^]"
      },
      {
        "do": "pair:]",
        "after": "- [ ]^"
      },
      {
        "do": "type: ",
        "after": "- [ ] ^"
      }
    ]
  },
  {
    "name": "(10) after an escaping backslash typed",
    "before": "a \\^",
    "marks": "^{}",
    "steps": [
