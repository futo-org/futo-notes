[
  {
    "name": "(8) [ writes a pair; a [ inside an empty pair grows it; at two it is typed",
    "before": "a ^",
    "marks": "^{}",
    "steps": [
      {
        "do": "pair:[",
        "after": "a [^]"
      },
      {
        "do": "pair:[",
        "after": "a [[^]]"
      },
      {
        "do": "pair:[",
        "after": "a [[[^]]"
      }
    ]
  },
  {
    "name": "(8) a ] steps over a shown ]; with none after it is typed",
    "before": "a [x^]",
    "marks": "^{}",
    "steps": [
      {
        "do": "pair:]",
        "after": "a [x]^"
      },
      {
        "do": "pair:]",
        "after": "a [x]]^"
      }
    ]
  },
  {
    "name": "(8) ( never pairs",
