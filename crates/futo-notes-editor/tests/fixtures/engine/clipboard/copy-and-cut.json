[
  {"name": "copy: a cut bold closes", "before": "**b[old** te]xt", "command": "copy", "copied": "**old** te", "after": "**b[old** te]xt"},
  {"name": "copy: a selection inside nested marks", "before": "a *i[t **b]** c* d", "command": "copy", "copied": "*t **b***", "after": "a *i[t **b]** c* d"},
  {"name": "copy: inline code", "before": "`c[o]`de", "command": "copy", "copied": "`o`", "after": "`c[o]`de"},
  {"name": "copy: a link keeps its destination", "before": "x [li*n{k*](u) y}", "command": "copy", "copied": "[*k*](u) y", "after": "x [li*n{k*](u) y}", "marks": "|{}"},
  {"name": "copy: a whole heading line carries its marker", "before": "[# Head]\nbody", "command": "copy", "copied": "# Head", "after": "[# Head]\nbody"},
  {"name": "copy: part of a heading does not", "before": "# H[ea]d\nbody", "command": "copy", "copied": "ea", "after": "# H[ea]d\nbody"},
  {"name": "copy: nested items lose the first line's indent", "before": "- a\n  - [b\n  - c]", "command": "copy", "copied": "- b\n- c", "after": "- a\n  - [b\n  - c]"},
  {"name": "copy: CRLF stays", "before": "[> a\r\n> b]", "command": "copy", "copied": "> a\r\n> b", "after": "[> a\r\n> b]"},
  {"name": "copy: spaces alone", "before": "a[  ]b", "command": "copy", "copied": "  ", "after": "a[  ]b"},
  {"name": "copy: a space in bold gets no marks", "before": "**a[ ]b**", "command": "copy", "copied": " ", "after": "**a[ ]b**"},
  {"name": "copy: a space in code gets no marks", "before": "`a[ ]b`", "command": "copy", "copied": " ", "after": "`a[ ]b`"},
  {"name": "copy: a collapsed selection copies nothing", "before": "a|b", "command": "copy", "copied": "", "after": "a|b"},
  {"name": "copy: code lines without their fence", "before": "```\n[code\nmore]\n```", "command": "copy", "copied": "code\nmore", "after": "```\n[code\nmore]\n```"},
  {"name": "copy: closes an opened fence", "before": "[x\n```js\ncode]\nmore\n```", "command": "copy", "copied": "x\n```js\ncode\n```", "after": "[x\n```js\ncode]\nmore\n```"},
  {"name": "copy: closes an indented CRLF fence", "before": "[x\r\n  ~~~js\r\ncode]\r\nmore\r\n  ~~~", "command": "copy", "copied": "x\r\n  ~~~js\r\ncode\r\n  ~~~", "after": "[x\r\n  ~~~js\r\ncode]\r\nmore\r\n  ~~~"},
  {"name": "copy: inside code adds no closing fence", "before": "```\n[code\nmore]\n```", "command": "copy", "copied": "code\nmore", "after": "```\n[code\nmore]\n```"},
  {"name": "copy: a whole fence from the line above", "before": "[x\n```\ncode\n```\n]y", "command": "copy", "copied": "x\n```\ncode\n```\n", "after": "[x\n```\ncode\n```\n]y"},
  {"name": "copy: a table row", "before": "| a | b |\n|---|---|\n[| 1 | 2 |]", "command": "copy", "copied": "| 1 | 2 |", "after": "| a | b |\n|---|---|\n[| 1 | 2 |]", "marks": "^[]"},
  {"name": "copy: a whole bullet with its box", "before": "{- [x] done}", "command": "copy", "copied": "- [x] done", "after": "{- [x] done}", "marks": "|{}"},
  {"name": "cut: bold text", "before": "a **[bold]** c", "command": "cut", "copied": "**bold**", "after": "a | c"},
  {"name": "cut: quote lines keep the first line's marker", "before": "> [a\n> b]\nz", "command": "cut", "copied": "> a\n> b", "after": "> |\nz"},
  {"name": "cut: a whole line from its start", "before": "a\n[- b]\nc", "command": "cut", "copied": "- b", "after": "a\n- |\nc"},
  {"name": "cut: nothing selected cuts nothing", "before": "a|b", "command": "cut", "copied": "", "after": "a|b"},
  {"name": "cut: across lines joins them", "before": "a[b\nc]d", "command": "cut", "copied": "b\nc", "after": "a|d"}
]
