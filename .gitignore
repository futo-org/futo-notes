# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencies
node_modules/
Pods/

# Build output
dist/
.sourcemaps

# Android
.gradle/
.kotlin/
local.properties
*.iml
.settings/
.project

# iOS
xcuserdata/
Podfile.lock
*.xcode.env.local
Build/
build/
Index/
DerivedData/

# Native signing
apps/ios/.signing-team
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
release.keystore
# Exception: the throwaway localdev updater key is committed on purpose — it
# signs only localhost dev builds and is rejected by every prod client (the
# prod pubkey is baked in). See keys/README.md. Like a shared debug keystore.
!keys/localdev-updater.key

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Environment files
.env
.env*.local

# TypeScript
*.tsbuildinfo

# IDE
.vscode
.idea/
.*sw*
# ...but the swift-format config is a real tracked file (the broad .*sw* rule
# above would otherwise eat it). See `just lint-swift`.
!apps/ios/.swift-format

app-example

# Server

# Playwright
.playwright-mcp
test-results/
playwright-report/

# Claude
.claude/local-plugins/*
.claude/worktrees
.claude/settings.local.json
.claude/projects/

# Local data (SQLite DB + notes)
data/
.tauri-data/
.triage-agent-home/
.triage-notes-data/

# Experiments live in ../notes-experiments
experiments/
.tmp

# Agent scratch (handoff notes)
handoff/

# Verification
test-screenshots

# Docker testing
futo-notes-data
/docker-compose.yml
/.futo-notes-cli.json
autoresearch-results.tsv

# CI caches/checkouts that GitLab restores INTO $CI_PROJECT_DIR. Untracked and
# enormous (a pnpm store is ~185k files / ~25MB of path text), so any tool that
# enumerates untracked files — `git ls-files --others` — must not see them.
.pnpm-store/
.cargo-home/
.cache-ms-playwright/
.gradle-native/
.futo-notes-server/
.cienv
build.env

# Rust
target/
# proptest writes a failing seed here; the failure output already prints it, and
# a stray generated dir must never land in a commit (AGENTS.md M16).
proptest-regressions/

# MCP config (local)
.mcp.json

# Codex
.codex
.context
.agents/

# Python bytecode (e.g. scripts/win-vm tooling)
__pycache__/
*.pyc

# VC++ redistributable, fetched at Windows build time by ci/win-build.ps1
apps/tauri/src-tauri/redist/

# Agent-tooling skill mirror (synced into the worktree by session tooling)
.agents/
