# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencies
node_modules/
Pods/

# Build output
dist/
.sourcemaps

# Android
.gradle/
.kotlin/
local.properties
*.iml
.settings/
.project

# iOS
xcuserdata/
Podfile.lock
*.xcode.env.local
Build/
build/
Index/
DerivedData/

# Native signing
apps/ios/.signing-team
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
release.keystore
# Exception: the throwaway localdev updater key is committed on purpose — it
# signs only localhost dev builds and is rejected by every prod client (the
# prod pubkey is baked in). See keys/README.md. Like a shared debug keystore.
!keys/localdev-updater.key

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Environment files
.env
.env*.local

# TypeScript
*.tsbuildinfo

# IDE
.vscode
.idea/
.*sw*
# ...but the swift-format config is a real tracked file (the broad .*sw* rule
# above would otherwise eat it). See `just lint-swift`.
!apps/ios/.swift-format

app-example

# Server

# Playwright
.playwright-mcp
test-results/
playwright-report/

# Claude
.claude/local-plugins/*
.claude/worktrees
.claude/settings.local.json
.claude/projects/

# Third-party skills from mattpocock/skills, recorded in skills-lock.json and
# installed into the gitignored .agents/ by an external installer. `just
# skills-link` symlinks them in per checkout; the links MUST stay untracked —
# a committed symlink into .agents/ dangles in every fresh clone and worktree,
# which is exactly how 22 of them shipped broken (MR !207).
.claude/skills/ask-matt
.claude/skills/code-review
.claude/skills/codebase-design
.claude/skills/diagnosing-bugs
.claude/skills/domain-modeling
.claude/skills/grill-me
.claude/skills/grill-with-docs
.claude/skills/grilling
.claude/skills/handoff
.claude/skills/implement
.claude/skills/improve-codebase-architecture
.claude/skills/prototype
.claude/skills/research
.claude/skills/resolving-merge-conflicts
.claude/skills/setup-matt-pocock-skills
.claude/skills/tdd
.claude/skills/teach
.claude/skills/to-spec
.claude/skills/to-tickets
.claude/skills/triage
.claude/skills/wayfinder
.claude/skills/writing-great-skills

# Local data (SQLite DB + notes)
data/
.tauri-data/
.triage-agent-home/
.triage-notes-data/

# Experiments live in ../notes-experiments
experiments/
.tmp

# Agent scratch (handoff notes)
handoff/

# Verification
test-screenshots

# Perf harness output (regenerable). perf-results is already excluded from
# remote runs (RSYNC_EXCLUDES in scripts/remote-test.mjs); .perf-course-cache
# is ~47MB of seeded vaults rebuilt on demand.
.perf-course-cache/
perf-results/

# Factory run captures — screenshots, last-run.json, parity matrices. Only the
# captures/ dirs: factories/*/ itself holds tracked source (see the
# rich-text-factory), so a blanket `factories/` ignore would hide real code.
# Mirrors the existing `factory/captures` rsync exclude.
factories/*/captures/

# Docker testing
futo-notes-data
/docker-compose.yml
/.futo-notes-cli.json
autoresearch-results.tsv

# CI caches/checkouts that GitLab restores INTO $CI_PROJECT_DIR. Untracked and
# enormous (a pnpm store is ~185k files / ~25MB of path text), so any tool that
# enumerates untracked files — `git ls-files --others` — must not see them.
.pnpm-store/
.cargo-home/
.cache-ms-playwright/
.gradle-native/
.futo-notes-server/
.cienv
build.env

# Rust
target/
# proptest writes a failing seed here; the failure output already prints it, and
# a stray generated dir must never land in a commit (AGENTS.md M16).
proptest-regressions/

# MCP config (local)
.mcp.json

# Codex
.codex
.context
.agents/

# Python bytecode (e.g. scripts/win-vm tooling)
__pycache__/
*.pyc

# VC++ redistributable, fetched at Windows build time by ci/win-build.ps1
apps/tauri/src-tauri/redist/

# Agent-tooling skill mirror (installed per machine; see `just skills-link`).
# Already ignored above under "Codex" — kept here so the reason is findable.
.pnpm-store/

# Scratch verification scripts
/tmp-*.mjs
