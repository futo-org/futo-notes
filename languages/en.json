{
  "$schema": "./catalog.schema.json",
  "language": {
    "nativeName": "English",
    "direction": "ltr",
    "aliases": []
  },
  "messages": {
    "app": {
      "android": {
        "displayName": "FUTO Notes",
        "debugDisplayName": "FUTO Notes Dev"
      },
      "ios": {
        "displayName": "FUTO Notes",
        "debugDisplayName": "FUTO Notes Dev"
      }
    },
    "settings": {
      "language": {
        "heading": "Language",
