            "variants": {
              "one": "{count} minute ago",
              "other": "{count} minutes ago"
            }
          },
          "hour": {
            "plural": "count",
            "variants": {
              "one": "{count} hour ago",
              "other": "{count} hours ago"
            }
          },
          "day": {
            "plural": "count",
            "variants": {
              "=1": "Yesterday",
              "other": "{count} days ago"
            }
          },
          "month": {
            "plural": "count",
            "variants": {
              "one": "{count} month ago",
              "other": "{count} months ago"
            }
          },
          "year": {
            "plural": "count",
            "variants": {
              "one": "{count} year ago",
              "other": "{count} years ago"
            }
          }
        },
        "future": {
          "minute": {
            "plural": "count",
            "variants": {
              "one": "In {count} minute",
              "other": "In {count} minutes"
            }
          },
          "hour": {
            "plural": "count",
            "variants": {
              "one": "In {count} hour",
              "other": "In {count} hours"
            }
          },
          "day": {
            "plural": "count",
            "variants": {
              "=1": "Tomorrow",
              "other": "In {count} days"
            }
          },
          "month": {
            "plural": "count",
            "variants": {
              "one": "In {count} month",
              "other": "In {count} months"
            }
          },
          "year": {
            "plural": "count",
            "variants": {
              "one": "In {count} year",
              "other": "In {count} years"
            }
          }
