[Unit]
Description=FUTO Notes GitHub issue triage — poll the mirror and post new issues to Zulip
Documentation=file:__REPO_DIR__/scripts/issue-triage/README.md
# Don't run when the workstation has no network; the timer retries next cycle.
Wants=network-online.target
After=network-online.target
# A red unit is not an alarm if nobody reads systemd: the old GitHub PAT expired
# on 2026-08-22 and 11 days of 401s went unnoticed. Route the failure to the
# same Zulip channel the poller feeds (throttled — see healthState.mjs).
OnFailure=futo-notes-issue-triage-failure.service

[Service]
Type=oneshot
# __NODE_BIN__ and __REPO_DIR__ are substituted by install-timer.sh so this
# unit carries no machine-specific (nvm) path in git.
ExecStart=__NODE_BIN__ __REPO_DIR__/scripts/issue-triage/poll.mjs
EnvironmentFile=%h/.config/futo-notes-issue-triage/env
# poll.mjs exits non-zero on any GitHub/Zulip failure; let that surface as a
# failed unit (the alarm) rather than masking it.
