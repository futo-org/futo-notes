# Credentials for the GitHub issue triage system.
#
# Copy to ~/.config/futo-notes-issue-triage/env, fill in real values, and
# `chmod 600` it. The systemd user service reads it via EnvironmentFile=.
# Interactive runs read the same values from ~/.zshrc instead.
#
# systemd EnvironmentFile syntax: KEY=value, one per line, no `export`, no
# surrounding quotes.

# Read-only, fine-grained PAT scoped to futo-org/futo-notes, Issues: read only.
# This read-only scope is what makes "the bot never writes to GitHub" true by
# construction. Never grant it write.
GITHUB_PAT=github_pat_xxx

# Dedicated Zulip generic bot "Issue Triage" (futo-notes-github-issues-bot).
ZULIP_TRIAGE_BOT_EMAIL=futo-notes-github-issues-bot@zulip.futo.org
ZULIP_TRIAGE_BOT_KEY=xxx

# Only needed once tier 2 (autonomous reproduction + MR) is enabled, so the
# agent can open a GitLab MR. Tier 1 (notify) does not use it.
GITLAB_TOKEN=xxx
