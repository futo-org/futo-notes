# Credentials for the weekly papercut sweep.
#
# Copy to ~/.config/futo-notes-papercut-sweep/env, fill in real values, and
# `chmod 600` it. The systemd user service reads it via EnvironmentFile=.
#
# systemd EnvironmentFile syntax: KEY=value, one per line, no `export`, no
# surrounding quotes.

# The sweep agent pushes its branch and opens the draft MR over the REST API.
# A project token or personal token with `api` scope.
GITLAB_TOKEN=xxx

# Optional. The model the headless session runs as; the launcher pins it
# explicitly so the run never inherits whatever the interactive default is.
# FUTO_PAPERCUT_SWEEP_MODEL=opus
