# Credentials for the MR factory.
#
# Copy to ~/.config/futo-notes-mr-factory/env, fill in real values, and
# `chmod 600` it. The systemd user service reads it via EnvironmentFile=.
#
# systemd EnvironmentFile syntax: KEY=value, one per line, no `export`, no
# surrounding quotes.

# /mr-qa reads MRs and merges SHIPs with it; the launcher posts the comment and
# label with it. A token with `api` scope.
GITLAB_TOKEN=xxx

# The "FUTO Notes Code Review" Zulip generic bot. Only the launcher sees these;
# they are removed from the agent's environment.
ZULIP_FACTORY_BOT_EMAIL=notes-code-review-bot@zulip.futo.org
ZULIP_FACTORY_BOT_KEY=xxx

# Optional. The model the headless session runs as; pinned so a run never
# inherits whatever the interactive default happens to be.
# FUTO_MR_FACTORY_MODEL=opus
