{
  "permissions": {
    "allow": [
      "Bash(gh api *)",
      "Bash(cargo clippy *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/session-orient.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/subagent-scratch.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
