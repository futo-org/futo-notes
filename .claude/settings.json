{
  "permissions": {
    "allow": [
      "Bash(gh api *)",
      "Bash(cargo clippy *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/session-orient.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/subagent-scratch.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); case \"$input\" in *puppet*) printf '%s' \"$input\" | node \"$CLAUDE_PROJECT_DIR/scripts/puppet-receipt-hook.mjs\";; esac"
          }
        ]
      }
    ]
  }
}
