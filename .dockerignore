# Deny all by default
*

# Whitelist Cargo workspace manifests
!Cargo.toml
!Cargo.lock

# Whitelist Rust crates
!crates/
crates/*/target/

# Whitelist shared package (for future Node.js builds)
!packages/shared/
packages/shared/node_modules/

# Whitelist the Node version pin and its installer — both CI images bake them
!.nvmrc
!ci
ci/*
!ci/install-fnm.sh
