{
  "name": "futo-notes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src packages/editor/src tests",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs",
    "lint:platform": "! git grep -n -E \"platform/(electron|capacitor)|isElectron|isCapacitor\" -- src ':(exclude)src/lib/platform/**' ':(exclude)src/**/__mocks__/**' ':(exclude)src/**/*.test.ts'",
    "check:command-reachability": "node scripts/check-command-reachability.mjs",
    "check:platform-discipline": "node scripts/check-platform-discipline.mjs",
    "check:sync-contract": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && cargo test -p futo-notes-tauri generated_typescript_contract_is_current",
    "check:drift": "node scripts/drift-check.mjs",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "check:qa-input-safety": "node scripts/check-qa-input-safety.mjs",
    "check:theme-single-pace": "node scripts/check-theme-single-pace.mjs",
    "check:supporter-coin-glyph": "node scripts/check-supporter-coin-glyph.mjs",
    "check:gate-redproofs": "node scripts/gate-redproofs.mjs",
    "check:languages": "node scripts/editor-deps.mjs && node scripts/language-catalogs.mjs",
    "audit:languages": "node scripts/language-catalogs.mjs --audit",
    "check:arch-gate:portable": "pnpm run check:command-reachability && pnpm run check:platform-discipline && pnpm run bridge-spec:check && pnpm run check:drift && pnpm run check:agent-docs && pnpm run check:qa-input-safety && pnpm run check:theme-single-pace && pnpm run check:supporter-coin-glyph",
    "check:arch-gate": "pnpm run check:arch-gate:portable && pnpm run check:sync-contract",
    "bridge-spec:check": "tsx scripts/gen-bridge-spec.ts --check",
    "test:full": "node scripts/editor-deps.mjs && vitest run",
    "test:e2e:smoke": "playwright test tests/p0-regressions.spec.ts",
    "test:editor-gauntlet:foreign:aggregate": "tsx tests/editor-gauntlet/aggregateForeignReports.ts",
    "test:editor-gauntlet:milkdown": "playwright test --config playwright.editor-gauntlet.config.ts tests/editor-gauntlet/milkdown-split-torture.spec.ts",
    "test:editor-gauntlet:milkdown:perf": "playwright test --config playwright.editor-gauntlet.config.ts tests/editor-gauntlet/milkdown-performance-floor.spec.ts",
    "test:editor-gauntlet:milkdown:foreign": "playwright test --config playwright.editor-gauntlet.config.ts tests/editor-gauntlet/milkdown-foreign-preservation.spec.ts",
    "test:e2e:full": "playwright test",
    "test:e2e:rest": "playwright test --workers=2 --grep-invert \"P0 Crash and IME Regressions\"",
    "test:e2e:editor-embed": "playwright test --config playwright.editor-embed.config.ts",
    "_comment": "Entry points for the web build, lint/format, the check:* repo gates and the vitest/Playwright suites. Tauri, mobile, deploy and everything else live in the justfile — use `just` from the repo root.",
    "test:cross-platform": "node tests/cross-platform-sync.mjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@floating-ui/dom": "^1.8.0",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lucide/svelte": "^0.574.0",
    "@milkdown/kit": "7.22.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jridgewell/trace-mapping": "0.3.31",
    "@lezer/markdown": "1.6.3",
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.186.0",
    "ajv": "^8.17.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "js-yaml": "^4.1.1",
    "jsdom": "^28.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.35.5",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "7.3.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.0.18",
    "ws": "^8.21.3"
  }
}
