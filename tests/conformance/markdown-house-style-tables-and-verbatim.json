{
  "description": "The editor's markdown house style (docs/spec/editor.md \"Markdown house style\", #266): what a save writes for a note, as hand-reviewed {source, expected} pairs. `source` is read with the app's own parser; `doc` instead gives an editor-made document no file could produce (ProseMirror toJSON shape). Every case also asserts that `expected` reads back as the same document and writes itself again unchanged. TypeScript only: the serializer has no Rust consumer. Runner: src/features/editor/milkdown/markdownHouseStyle.test.ts.",
  "cases": [
    {
      "story": 14,
      "name": "table cells get one space each side, no column padding",
      "source": "|a|b|\n|-|-|\n|1|2|\n|  long cell  |x|",
      "expected": "| a | b |\n| --- | --- |\n| 1 | 2 |\n| long cell | x |\n"
    },
    {
      "story": 14,
      "name": "a pipe in a cell is \\|, in text and code",
      "source": "| a \\| b | `c\\|d` |\n| --- | --- |",
      "expected": "| a \\| b | `c\\|d` |\n| --- | --- |\n"
    },
    {
      "story": 14,
      "name": "a line break in a cell is <br>",
      "source": "| a<br>b |\n| --- |",
      "expected": "| a<br>b |\n| --- |\n"
    },
    {
      "story": 14,
      "name": "a line break at the end of a cell is <br> too: x<br> reads back as x and a line break",
      "source": "| x<br> | y<br><br> |\n| --- | --- |\n| **z**<br> | a<br>b<br> |",
      "expected": "| x<br> | y<br><br> |\n| --- | --- |\n| **z**<br> | a<br>b<br> |\n"
    },
    {
      "story": 14,
      "name": "a cell holding two or more line breaks and nothing else writes each as <br>",
      "source": "| <br><br> | x |\n| --- | --- |\n| <br> <br> | <br><br><br> |",
      "expected": "| <br><br> | x |\n| --- | --- |\n| <br> <br> | <br><br><br> |\n"
    },
    {
      "story": 14,
      "name": "a cell holding a single line break and nothing else is written empty: a lone <br> reads back as an empty cell",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "table",
            "content": [
              {
                "type": "table_header_row",
                "content": [
                  {
                    "type": "table_header",
                    "attrs": {
                      "colspan": 1,
                      "rowspan": 1,
                      "colwidth": null,
                      "alignment": null
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "a"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "table_header",
                    "attrs": {
                      "colspan": 1,
                      "rowspan": 1,
                      "colwidth": null,
                      "alignment": null
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "b"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "table_row",
                "content": [
                  {
                    "type": "table_cell",
                    "attrs": {
                      "colspan": 1,
                      "rowspan": 1,
                      "colwidth": null,
                      "alignment": null
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "hardbreak",
                            "attrs": {
                              "isInline": false
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "table_cell",
                    "attrs": {
                      "colspan": 1,
                      "rowspan": 1,
                      "colwidth": null,
                      "alignment": null
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": " "
                          },
                          {
                            "type": "hardbreak",
                            "attrs": {
                              "isInline": false
                            }
                          },
                          {
                            "type": "text",
                            "text": " "
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "| a | b |\n| --- | --- |\n|  |  |\n"
    },
    {
      "name": "Shift+Enter at the end of a cell's text is a <br> the save keeps",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "table",
            "content": [
              {
                "type": "table_header_row",
                "content": [
                  {
                    "type": "table_header",
                    "attrs": {
                      "colspan": 1,
                      "rowspan": 1,
                      "colwidth": null,
                      "alignment": null
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "a"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "table_row",
                "content": [
                  {
                    "type": "table_cell",
                    "attrs": {
                      "colspan": 1,
                      "rowspan": 1,
                      "colwidth": null,
                      "alignment": null
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "x"
                          },
                          {
                            "type": "hardbreak",
                            "attrs": {
                              "isInline": false
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "| a |\n| --- |\n| x<br> |\n"
    },
    {
      "story": 14,
      "name": "a ragged row is padded at the end",
      "source": "| a | b |\n| --- | --- |\n| 1 |",
      "expected": "| a | b |\n| --- | --- |\n| 1 |  |\n"
    },
    {
      "story": 14,
      "name": "a table with no body rows",
      "source": "|a|\n|-|",
      "expected": "| a |\n| --- |\n"
    },
    {
      "story": 15,
      "name": "alignments: unset ---, left :--, center :-:, right --:",
      "source": "| a | b | c | d |\n|---|:--|:-:|--:|\n| 1 | 2 | 3 | 4 |",
      "expected": "| a | b | c | d |\n| --- | :-- | :-: | --: |\n| 1 | 2 | 3 | 4 |\n"
    },
    {
      "story": 16,
      "name": "front matter is written back byte for byte",
      "source": "---\ntags: [a, b]\ntitle: \"x*y*\"  \n\nnested:\n  - _z_\n---\n\nbody _x_",
      "expected": "---\ntags: [a, b]\ntitle: \"x*y*\"  \n\nnested:\n  - _z_\n---\n\nbody *x*\n"
    },
    {
      "story": 16,
      "name": "a note of only front matter",
      "source": "---\na: 1\n---",
      "expected": "---\na: 1\n---\n"
    },
    {
      "story": 17,
      "name": "wikilinks keep their raw target",
      "source": "[[Projects/Road map]] and [[a_b*c*]] and ![[embed]]",
      "expected": "[[Projects/Road map]] and [[a_b*c*]] and ![[embed]]\n"
    },
    {
      "story": 17,
      "name": "a pipe in a wikilink in a cell is \\|",
      "source": "| [[a\\|b]] |\n| --- |",
      "expected": "| [[a\\|b]] |\n| --- |\n"
    },
    {
      "story": 17,
      "name": "text that looks like a wikilink keeps its escape",
      "source": "\\[[not a link]]",
      "expected": "\\[[not a link]]\n"
    },
    {
      "story": 17,
      "name": "two escapes before [[ come back as one, on the opener",
      "source": "\\[\\[x]] **b**",
      "expected": "\\[[x]] **b**\n"
    },
    {
      "story": 18,
      "name": "images keep their syntax and never gain a title",
      "source": "![](image-1.png) ![alt](b.png \"T\") ![a](<c d.png>)",
      "expected": "![](image-1.png) ![alt](b.png \"T\") ![a](<c d.png>)\n"
    },
    {
      "story": 19,
      "name": "inline and block HTML are kept exactly",
      "source": "Press <kbd>Ctrl</kbd> <span class=\"x\">y</span>\n\n<div>\n  x\n</div>",
      "expected": "Press <kbd>Ctrl</kbd> <span class=\"x\">y</span>\n\n<div>\n  x\n</div>\n"
    },
    {
      "story": 19,
      "name": "a multi-line inline tag keeps its indent",
      "source": "a <span\n       b='1'>x</span>",
      "expected": "a <span\n       b='1'>x</span>\n"
    },
    {
      "story": 20,
      "name": "an unused link reference definition is kept",
      "source": "[unused]: https://x.com \"T\"\n\ntext",
      "expected": "[unused]: https://x.com \"T\"\n\ntext\n"
    },
    {
      "story": 20,
      "name": "a used definition moves into its link",
      "source": "[a][x]\n\n[x]: /u",
      "expected": "[a](/u)\n"
    },
    {
      "story": 20,
      "name": "text that would use a kept definition keeps its escape",
      "source": "\\[x]\n\n[x]: /u",
      "expected": "\\[x]\n\n[x]: /u\n"
    },
    {
      "story": 21,
      "name": "trailing empty paragraphs are not written",
      "source": "a\n\n\n\n\n",
      "expected": "a\n"
    },
    {
      "story": 22,
      "name": "CRLF and CR are written LF, code included; front matter keeps its own line endings (story 16)",
      "source": "---\r\na: 1\r\nb: 2\r\n---\r\n\r\nx\r\ny\r\n\r\n```\r\nc\r\n```",
      "expected": "---\r\na: 1\r\nb: 2\r\n---\n\nx\ny\n\n```\nc\n```\n"
    },
    {
      "story": 16,
      "name": "front matter from a CR file keeps its CR line endings, fences included",
      "source": "---\ra: 1\rb: 2\r---\r\rx",
      "expected": "---\ra: 1\rb: 2\r---\n\nx\n"
    },
    {
      "story": 16,
      "name": "a one-line front matter body from a CRLF file gets LF fences: the parser keeps no line ending beside a fence",
      "source": "---\r\na: 1\r\n---\r\n\r\nx",
      "expected": "---\na: 1\n---\n\nx\n"
    },
    {
      "story": 22,
      "name": "a lone CR is a line break",
      "source": "a\rb",
      "expected": "a\nb\n"
    }
  ]
}
