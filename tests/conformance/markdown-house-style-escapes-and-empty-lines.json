{
  "description": "The editor's markdown house style (docs/spec/editor.md \"Markdown house style\", #266): what a save writes for a note, as hand-reviewed {source, expected} pairs. `source` is read with the app's own parser; `doc` instead gives an editor-made document no file could produce (ProseMirror toJSON shape). Every case also asserts that `expected` reads back as the same document and writes itself again unchanged. TypeScript only: the serializer has no Rust consumer. Runner: src/features/editor/milkdown/markdownHouseStyle.test.ts.",
  "cases": [
    {
      "name": "two touching lists alternate - and *",
      "source": "- a\n* b\n- c",
      "expected": "- a\n\n* b\n\n- c\n"
    },
    {
      "name": "lists separated only by an empty paragraph alternate",
      "source": "- a\n\n\n* b\n\n\n1. c\n\n\n1) d",
      "expected": "- a\n\n\n* b\n\n\n1. c\n\n\n1) d\n"
    },
    {
      "name": "a list after a paragraph uses the default marker again",
      "source": "* a\n\ntext\n\n+ b",
      "expected": "- a\n\ntext\n\n- b\n"
    },
    {
      "name": "bold whose edge is punctuation next to a letter keeps flanking",
      "source": "**Note:**&#x62;ar",
      "expected": "**Note:**&#x62;ar\n"
    },
    {
      "name": "CJK bold ending in full-width punctuation",
      "source": "**注意：**&#x6587;本",
      "expected": "**注意：**&#x6587;本\n"
    },
    {
      "name": "an escaped hash before bold stays escaped",
      "source": "\\# a **b**",
      "expected": "\\# a **b**\n"
    },
    {
      "name": "entities: plain & stays bare, an entity-like literal keeps its escape",
      "source": "AT&amp;T and \\&copy;",
      "expected": "AT&T and \\&copy;\n"
    },
    {
      "name": "spaces from references at a line's start are kept, the first still a reference: the parser drops raw line-start whitespace",
      "source": "&#x20;&#x20;a\n\n&#x20;&#x20;&#x20;&#x20;not code\n\nb\\\n&#x9;c",
      "expected": "&#x20; a\n\n&#x20;   not code\n\nb\\\n&#x9;c\n"
    },
    {
      "story": 7,
      "name": "a line holding only a space reference is an empty line: a paragraph break",
      "source": "a\n&#x20;\nb",
      "expected": "a\n\nb\n"
    },
    {
      "name": "footnotes, continuation indented four",
      "source": "x[^1] and \\[^1]\n\n[^1]: note\n  lazy\n\n    second",
      "expected": "x[^1] and \\[^1]\n\n[^1]: note\n    lazy\n\n    second\n"
    },
    {
      "name": "links: titles, spaces and balanced parentheses",
      "source": "[a](<b c> \"t\\\"x\") [w](https://en.wikipedia.org/wiki/Foo_(bar)) [e]()",
      "expected": "[a](<b c> \"t\\\"x\") [w](https://en.wikipedia.org/wiki/Foo_(bar)) [e]()\n"
    },
    {
      "name": "Enter after \"Press \" before inline HTML: one newline, no trailing space (#263)",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Press "
              },
              {
                "type": "hardbreak",
                "attrs": {
                  "isInline": true
                }
              },
              {
                "type": "html",
                "attrs": {
                  "value": "<kbd>"
                }
              },
              {
                "type": "text",
                "text": "Ctrl"
              },
              {
                "type": "html",
                "attrs": {
                  "value": "</kbd>"
                }
              },
              {
                "type": "text",
                "text": " now"
              }
            ]
          }
        ]
      },
      "expected": "Press\n<kbd>Ctrl</kbd> now\n"
    },
    {
      "story": 7,
      "name": "an empty line typed inside a paragraph is an empty line, which the file reads as a paragraph break (#263)",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "a"
              },
              {
                "type": "hardbreak",
                "attrs": {
                  "isInline": true
                }
              },
              {
                "type": "hardbreak",
                "attrs": {
                  "isInline": true
                }
              },
              {
                "type": "text",
                "text": "b"
              }
            ]
          }
        ]
      },
      "expected": "a\n\nb\n"
    },
    {
      "story": 7,
      "name": "two empty lines typed inside a paragraph are a paragraph break and one empty paragraph",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "a"
              },
              {
                "type": "hardbreak",
                "attrs": {
                  "isInline": true
                }
              },
              {
                "type": "hardbreak",
                "attrs": {
                  "isInline": true
                }
              },
              {
                "type": "hardbreak",
                "attrs": {
                  "isInline": true
                }
              },
              {
                "type": "text",
                "text": "b"
              }
            ]
          }
        ]
      },
      "expected": "a\n\n\nb\n"
    },
    {
      "story": 7,
      "name": "a paragraph that starts with an empty line has an empty paragraph before it: two Enters at the end of one in one\\ntwo save a blank line, never &#x20;",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "a"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "hardbreak",
                "attrs": {
                  "isInline": true
                }
              },
              {
                "type": "text",
                "text": "b"
              }
            ]
          }
        ]
      },
      "expected": "a\n\n\nb\n"
    },
    {
      "story": 7,
      "name": "a note whose first paragraph starts with an empty line starts with a blank line",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "hardbreak",
                "attrs": {
                  "isInline": true
                }
              },
              {
                "type": "text",
                "text": "b"
              }
            ]
          }
        ]
      },
      "expected": "\nb\n"
    },
    {
      "story": 7,
      "name": "bold across an empty line closes before it and opens again after",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "marks": [
                  {
                    "type": "strong",
                    "attrs": {
                      "marker": "*"
                    }
                  }
                ],
                "text": "a"
              },
              {
                "type": "hardbreak",
                "attrs": {
                  "isInline": true
                },
                "marks": [
                  {
                    "type": "strong",
                    "attrs": {
                      "marker": "*"
                    }
                  }
                ]
              },
              {
                "type": "hardbreak",
                "attrs": {
                  "isInline": true
                },
                "marks": [
                  {
                    "type": "strong",
                    "attrs": {
                      "marker": "*"
                    }
                  }
                ]
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "strong",
                    "attrs": {
                      "marker": "*"
                    }
                  }
                ],
                "text": "b"
              }
            ]
          }
        ]
      },
      "expected": "**a**\n\n**b**\n"
    },
    {
      "story": 7,
      "name": "a hard break before an empty line ends the paragraph and is not written",
      "source": "a\\\n&#x20;\nb",
      "expected": "a\n\nb\n"
    },
    {
      "story": 7,
      "name": "an empty line in a list item's paragraph makes two paragraphs and the item loose",
      "source": "- a\n  &#x20;\n  b\n- c",
      "expected": "- a\n\n  b\n- c\n"
    },
    {
      "story": 7,
      "name": "an empty line at the start of a list item is not written",
      "source": "- &#x20;\n  b",
      "expected": "- b\n"
    },
    {
      "story": 7,
      "name": "an empty line in a quoted paragraph is a blank > line",
      "source": "> a\n> &#x20;\n> b",
      "expected": "> a\n>\n> b\n"
    },
    {
      "story": 7,
      "name": "a link whose text starts or ends at a line break keeps it: that line holds the [ or the ](…)",
      "source": "[\nb](u)\n\n- [\n  c](u)\n\n[d\n](u)\nx",
      "expected": "[\nb](u)\n\n- [\n  c](u)\n\n[d\n](u)\nx\n"
    }
  ]
}
