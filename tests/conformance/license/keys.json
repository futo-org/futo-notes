  "constants": {
    "$comment": "The baked-in constants every shell must agree on. Selection between environments follows the existing dev/prod split (M3).",
    "productSlug": "futo-notes",
    "checkoutProductSlug": "futo-notes-license",
    "orgSlug": "futo-notes",
    "deepLinkScheme": "futonotes",
    "keyAlphabet": "ABCDEFGHJKMNPQRSTUVWXYZ123456789",
    "supportMailto": "mailto:support@futo.tech",
    "appStoreProductId": "com.futo.notes.license",
    "websiteAddress": {
      "$comment": "What a NameWebsite build (Android play) shows as plain, non-tappable text: the storefront as a person types it. Production is pay.futo.org, which serves the same storefront as pay2.futo.org (@justin 2026-10-19); staging has no short alias and names its own host. Environment-split like buyUrls (M3).",
      "production": "pay.futo.org",
      "staging": "staging-pay2.futo.org"
    },
    "buyUrls": {
      "$comment": "The Buy / Renew destination, opened in the system browser. It is the generated checkout on the environment's own pay2 host — there is no pay.futo.tech landing page and there will not be one (product decision 2026-09-10). Environment-split like the verification key and the activation host (M3), so a .dev build reaches staging checkout. The product segment is the STOREFRONT slug, `futo-notes-license` — not `futo-notes`, which is the product field inside an activation payload and names nothing in the storefront (its /price answers \"Product not found: futo-notes\", observed 2026-09-10). `platform` and `from` (the surface that sent the buyer; the fixture pins `license-card`, the other source is exact-string tested in config.rs) are attribution only; `success` is the buyer's return marker and is `redirect-to-organization-page` because the buyer pays in the system browser: FUTOpay answers that marker with the license key page (the key as HTML plus the Activate deep link), while an empty value answers with the raw activation JSON — the contract of the in-app-WebView clients this app never runs, and what a buyer who just paid saw on staging 2026-09-11.",
      "production": {
        "desktop": "https://pay2.futo.org/checkout/polar/futo-notes/futo-notes-license/checkout-ready?platform=desktop&from=license-card&success=redirect-to-organization-page",
        "ios": "https://pay2.futo.org/checkout/polar/futo-notes/futo-notes-license/checkout-ready?platform=ios&from=license-card&success=redirect-to-organization-page",
        "android": "https://pay2.futo.org/checkout/polar/futo-notes/futo-notes-license/checkout-ready?platform=android&from=license-card&success=redirect-to-organization-page"
      },
      "staging": {
        "desktop": "https://staging-pay2.futo.org/checkout/polar/futo-notes/futo-notes-license/checkout-ready?platform=desktop&from=license-card&success=redirect-to-organization-page",
        "ios": "https://staging-pay2.futo.org/checkout/polar/futo-notes/futo-notes-license/checkout-ready?platform=ios&from=license-card&success=redirect-to-organization-page",
        "android": "https://staging-pay2.futo.org/checkout/polar/futo-notes/futo-notes-license/checkout-ready?platform=android&from=license-card&success=redirect-to-organization-page"
      }
    },
    "environments": {
      "production": {
        "pay2BaseUrl": "https://pay2.futo.org",
        "bundleIds": ["com.futo.notes"]
      },
      "staging": {
        "pay2BaseUrl": "https://staging-pay2.futo.org",
        "bundleIds": ["com.futo.notes.dev"]
      },
      "$comment": "Which build talks to which org. The `.dev` id suffix IS the dev/prod split (M3) and is the only selector, because the native shells compile the FFI with `release-ffi` for their dev apps too — a compile-profile test would put a .dev phone build on the production key."
    }
  },
