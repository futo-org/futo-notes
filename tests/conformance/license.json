      "storefrontCountry": "",
      "buildAllows": true,
      "expected": false
    },
    {
      "name": "unknown iOS",
      "platform": "ios",
      "storefrontCountry": null,
      "buildAllows": true,
      "expected": false
    },
    {
      "name": "disabled US iOS",
      "platform": "ios",
      "storefrontCountry": "USA",
      "buildAllows": false,
      "expected": false
    },
    {
      "name": "direct Android",
      "platform": "android",
      "storefrontCountry": null,
      "buildAllows": true,
      "expected": true
    },
    {
      "name": "Play Android",
      "platform": "android",
      "storefrontCountry": null,
      "buildAllows": false,
      "expected": false
    },
    {
      "name": "Android ignores country",
      "platform": "android",
      "storefrontCountry": "FRA",
      "buildAllows": true,
      "expected": true
    },
    {
      "name": "desktop unchanged",
      "platform": "desktop",
      "storefrontCountry": null,
      "buildAllows": false,
      "expected": true
    }
  ],
  "purchaseSurface": [
    {
      "name": "desktop",
      "distribution": "desktop",
      "storefrontCountry": null,
      "expected": "linkOut"
    },
    {
      "name": "US iOS",
      "distribution": "iosAppStore",
      "storefrontCountry": "USA",
      "expected": "linkOut"
    },
    {
      "name": "non-US iOS",
      "distribution": "iosAppStore",
      "storefrontCountry": "FRA",
      "expected": "keyOnly"
    },
    {
      "name": "unknown iOS storefront fails closed",
      "distribution": "iosAppStore",
      "storefrontCountry": null,
      "expected": "keyOnly"
    },
    {
      "name": "lowercase is not the US storefront",
      "distribution": "iosAppStore",
      "storefrontCountry": "usa",
      "expected": "keyOnly"
    },
    {
      "name": "direct Android",
      "distribution": "androidDirect",
      "storefrontCountry": null,
      "expected": "linkOut"
    },
    {
      "name": "Play Android",
      "distribution": "androidPlay",
      "storefrontCountry": null,
      "expected": "nameWebsite"
    },
    {
      "name": "Play Android in the US still only names the website",
      "distribution": "androidPlay",
      "storefrontCountry": "USA",
      "expected": "nameWebsite"
    }
  ],
  "appStoreEvidence": [
    {
      "$comment": "iOS only (ADR-0009). The App Store-only purchase includes exactly what a Licensed key includes (App Review 3.1.3(b) parity), and a Licensed key wins the plate because it carries more: a key, Remove, the other platforms."
    },
    {
      "name": "no key, no purchase",
      "key": "unlicensed",
      "appStore": false,
      "expected": {
        "plate": "unlicensed",
        "includes": []
      }
    },
    {
      "name": "an App Store purchase alone",
      "key": "unlicensed",
      "appStore": true,
      "expected": {
        "plate": "appStore",
        "includes": [
          "appIcon"
        ]
      }
    },
    {
      "name": "an App Store purchase beside an expired key",
      "key": "expired",
      "appStore": true,
      "expected": {
        "plate": "appStore",
        "includes": [
          "appIcon"
        ]
      }
    },
    {
      "name": "an expired key alone",
      "key": "expired",
      "appStore": false,
      "expected": {
        "plate": "expired",
        "includes": []
      }
    },
    {
      "name": "a Licensed key beside an App Store purchase",
      "key": "licensed",
      "appStore": true,
      "expected": {
        "plate": "licensed",
        "includes": [
          "appIcon"
        ]
      }
    },
    {
      "name": "a Licensed key alone",
      "key": "licensed",
      "appStore": false,
      "expected": {
        "plate": "licensed",
        "includes": [
          "appIcon"
        ]
      }
    }
  ],
  "licenseKey": [
    {
      "name": "the spec's example key",
      "input": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "normalized": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": true
    },
    {
      "name": "no org prefix",
      "input": "AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "normalized": "AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": true
    },
    {
      "name": "lowercase is accepted and uppercased",
      "input": "fn-ab12-cd34-ef56-gh78-jk12-mn34-pq56-rs78",
      "normalized": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": true
    },
    {
      "name": "surrounding whitespace is trimmed",
      "input": "  \tFN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78\n ",
      "normalized": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": true
    },
    {
      "name": "mixed case with whitespace, as pasted out of an email",
      "input": " Fn-Ab12-cD34-EF56-gh78-JK12-mn34-PQ56-rs78 ",
      "normalized": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": true
    },
    {
      "name": "seven groups",
      "input": "AB12-CD34-EF56-GH78-JK12-MN34-PQ56",
      "normalized": "AB12-CD34-EF56-GH78-JK12-MN34-PQ56",
      "valid": false
    },
    {
      "name": "prefix plus nine groups",
      "input": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78-TU99",
      "normalized": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78-TU99",
      "valid": false
    },
    {
      "name": "a group of three characters",
      "input": "AB1-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "normalized": "AB1-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": false
    },
    {
      "name": "letter I is not in the FUTOpay alphabet",
      "input": "AI12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "normalized": "AI12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": false
    },
    {
      "name": "letter O is not in the FUTOpay alphabet",
      "input": "ABO2-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "normalized": "ABO2-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": false
    },
    {
      "name": "letter L is not in the FUTOpay alphabet",
      "input": "ABL2-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "normalized": "ABL2-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": false
    },
    {
      "name": "digit 0 is not in the FUTOpay alphabet",
      "input": "AB10-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "normalized": "AB10-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": false
    },
    {
      "name": "empty prefix (leading hyphen)",
      "input": "-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "normalized": "-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": false
    },
    {
      "name": "a long org prefix is accepted — the spec does not bound it, and refusing one would reject a license the server really minted",
      "input": "VERYLONGPREFIX-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "normalized": "VERYLONGPREFIX-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": true
    },
    {
      "name": "a prefix may use characters the group alphabet excludes",
      "input": "IO0L-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "normalized": "IO0L-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": true
    },
    {
      "name": "empty string",
      "input": "",
      "normalized": "",
      "valid": false
    },
    {
      "name": "whitespace only",
      "input": "   ",
      "normalized": "",
      "valid": false
    },
    {
      "name": "a word",
      "input": "hello",
      "normalized": "HELLO",
      "valid": false
    },
    {
      "name": "internal whitespace is not stripped",
      "input": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS 78",
      "normalized": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS 78",
      "valid": false
    },
    {
      "name": "a prefix containing whitespace is not one token",
      "input": "FN X-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "normalized": "FN X-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "valid": false
    }
  ],
  "recognizeInput": [
    {
      "name": "bare key",
      "input": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "expected": {
        "shape": "bareKey",
        "key": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78"
      }
    },
    {
      "name": "bare key, lowercase and padded with whitespace",
      "input": "\n  fn-ab12-cd34-ef56-gh78-jk12-mn34-pq56-rs78  \t",
      "expected": {
        "shape": "bareKey",
        "key": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78"
      }
    },
    {
      "name": "key/activation pair",
      "input": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78/v2.cGF5bG9hZA.c2ln",
      "expected": {
        "shape": "pair",
        "key": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
        "activation": "v2.cGF5bG9hZA.c2ln"
      }
    },
    {
      "name": "pair with whitespace and a lowercase key — the activation's case is preserved",
      "input": "  fn-ab12-cd34-ef56-gh78-jk12-mn34-pq56-rs78/v2.cGF5bG9hZA.c2ln  ",
      "expected": {
        "shape": "pair",
        "key": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
        "activation": "v2.cGF5bG9hZA.c2ln"
      }
    },
    {
      "name": "full deep-link URL",
      "input": "futonotes://license/FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78/v2.cGF5bG9hZA.c2ln",
      "expected": {
        "shape": "pair",
        "key": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
        "activation": "v2.cGF5bG9hZA.c2ln"
      }
    },
    {
      "name": "deep-link URL with an uppercase scheme and host, padded",
      "input": " FUTONOTES://License/fn-ab12-cd34-ef56-gh78-jk12-mn34-pq56-rs78/v2.cGF5bG9hZA.c2ln ",
      "expected": {
        "shape": "pair",
        "key": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
        "activation": "v2.cGF5bG9hZA.c2ln"
      }
    },
    {
      "name": "deep-link URL with a trailing slash",
      "input": "futonotes://license/FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78/v2.cGF5bG9hZA.c2ln/",
      "expected": {
        "shape": "pair",
        "key": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
        "activation": "v2.cGF5bG9hZA.c2ln"
      }
    },
    {
      "name": "deep-link URL with a query string the checkout page may append",
      "input": "futonotes://license/FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78/v2.cGF5bG9hZA.c2ln?src=checkout",
      "expected": {
        "shape": "pair",
        "key": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
        "activation": "v2.cGF5bG9hZA.c2ln"
      }
    },
    {
      "name": "a malformed key is still recognised as a shape — content is judged by evaluate, not by recognition",
      "input": "hello",
      "expected": {
        "shape": "bareKey",
        "key": "HELLO"
      }
    },
    {
      "name": "empty input is not a license at all",
      "input": "",
      "expected": null
    },
    {
      "name": "whitespace only",
      "input": "   \n ",
      "expected": null
    },
    {
      "name": "pair with an empty activation",
      "input": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78/",
      "expected": null
    },
    {
      "name": "pair with an empty key",
      "input": "/v2.cGF5bG9hZA.c2ln",
      "expected": null
    },
    {
      "name": "three slash-separated segments is not a shape we accept",
      "input": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78/v2.cGF5bG9hZA.c2ln/extra",
      "expected": null
    },
    {
      "name": "an https URL pasted into the field",
      "input": "https://pay2.futo.org/checkout/polar/futo-notes/futo-notes-license/checkout-ready?platform=desktop&from=license-card&success=redirect-to-organization-page",
      "expected": null
    },
    {
      "name": "another app's deep link",
      "input": "grayjay://license/FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78/c2ln",
      "expected": null
    }
  ],
  "deepLink": [
    {
      "name": "the defined path",
      "input": "futonotes://license/FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78/v2.cGF5bG9hZA.c2ln",
      "expected": {
        "key": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
        "activation": "v2.cGF5bG9hZA.c2ln"
      }
    },
    {
      "name": "scheme and host are case-insensitive; the activation is not",
      "input": "FutoNotes://LICENSE/FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78/v2.cGF5bG9hZA.c2ln",
      "expected": {
        "key": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
        "activation": "v2.cGF5bG9hZA.c2ln"
      }
    },
    {
      "name": "a garbage key still matches the path shape, so the shell toasts rather than ignoring",
      "input": "futonotes://license/hello/world",
      "expected": {
        "key": "HELLO",
        "activation": "world"
      }
    },
    {
      "name": "another host is ignored silently",
      "input": "futonotes://settings/FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78/v2.cGF5bG9hZA.c2ln",
      "expected": null
    },
    {
      "name": "the license host with too few segments is ignored silently",
      "input": "futonotes://license/FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78",
      "expected": null
    },
    {
      "name": "the license host with too many segments is ignored silently",
      "input": "futonotes://license/FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78/v2.cGF5bG9hZA.c2ln/extra",
      "expected": null
    },
    {
      "name": "no host at all is ignored silently",
      "input": "futonotes://",
      "expected": null
    },
    {
      "name": "another scheme is ignored silently",
      "input": "grayjay://license/FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78/v2.cGF5bG9hZA.c2ln",
      "expected": null
    },
    {
      "name": "a bare pair is not a deep link",
      "input": "FN-AB12-CD34-EF56-GH78-JK12-MN34-PQ56-RS78/v2.cGF5bG9hZA.c2ln",
      "expected": null
    }
  ]
}
