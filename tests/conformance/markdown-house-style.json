{
  "description": "The editor's markdown house style (docs/spec/editor.md \"Markdown house style\", #266): what a save writes for a note, as hand-reviewed {source, expected} pairs. `source` is read with the app's own parser; `doc` instead gives an editor-made document no file could produce (ProseMirror toJSON shape). Every case also asserts that `expected` reads back as the same document and writes itself again unchanged. TypeScript only: the serializer has no Rust consumer. Runner: src/features/editor/milkdown/markdownHouseStyle.test.ts.",
  "cases": [
    {
      "story": 2,
      "name": "a *** rule is written ---",
      "source": "a\n\n***\n\nb",
      "expected": "a\n\n---\n\nb\n"
    },
    {
      "story": 2,
      "name": "a ___ rule is written ---",
      "source": "a\n\n___\n\nb",
      "expected": "a\n\n---\n\nb\n"
    },
    {
      "story": 2,
      "name": "a rule on the first line is *** (--- would open front matter)",
      "source": "---\n\ntext\n\n---\n\nmore",
      "expected": "---\n\ntext\n\n---\n\nmore\n"
    },
    {
      "story": 2,
      "name": "an unclosed --- on line 1 is a rule, written ***",
      "source": "---\n\n- a\n\n> q",
      "expected": "***\n\n- a\n\n> q\n"
    },
    {
      "story": 2,
      "name": "a rule as a - item's first block is ***",
      "source": "- ***",
      "expected": "- ***\n"
    },
    {
      "story": 2,
      "name": "a rule under a tight item's paragraph is *** (--- would be a setext underline)",
      "source": "- a\n  ***",
      "expected": "- a\n  ***\n"
    },
    {
      "story": 3,
      "name": "* and + bullets are written -",
      "source": "* one\n* two\n\n+ three",
      "expected": "- one\n- two\n\n* three\n"
    },
    {
      "story": 3,
      "name": "_ emphasis and __ strong are written * and **",
      "source": "_it_ and __bold__ and ___both___",
      "expected": "*it* and **bold** and ***both***\n"
    },
    {
      "story": 3,
      "name": "single and double tilde strikethrough are written ~~",
      "source": "~one~ and ~~two~~",
      "expected": "~~one~~ and ~~two~~\n"
    },
    {
      "story": 3,
      "name": "marks over the same text nest strikethrough outermost, then bold, then italic",
      "source": "***~~hello~~***",
      "expected": "~~***hello***~~\n"
    },
    {
      "story": 3,
      "name": "an italic inside a word is written with *, which opens and closes there",
      "source": "&#x78;_a_&#x79;",
      "expected": "x*a*y\n"
    },
    {
      "story": 3,
      "name": "two italic runs that touch are one italic run (typing Z before _b_*c*)",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "a Z"
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "emphasis",
                    "attrs": {
                      "marker": "_"
                    }
                  }
                ],
                "text": "b"
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "emphasis",
                    "attrs": {
                      "marker": "*"
                    }
                  }
                ],
                "text": "c"
              }
            ]
          }
        ]
      },
      "expected": "a Z*bc*\n"
    },
    {
      "story": 4,
      "name": "underscores inside words and in math are not escaped",
      "source": "snake_case_word, $x_1$, file_name.txt and #dog_problems",
      "expected": "snake_case_word, $x_1$, file_name.txt and #dog_problems\n"
    },
    {
      "story": 4,
      "name": "a lone underscore needs no escape",
      "source": "a \\_ b",
      "expected": "a _ b\n"
    },
    {
      "story": 4,
      "name": "a literal *x* keeps the one escape it needs, on the opener",
      "source": "\\*not italic\\*",
      "expected": "\\*not italic*\n"
    },
    {
      "story": 4,
      "name": "asterisks that cannot be emphasis stay bare",
      "source": "2 * 3 * 4",
      "expected": "2 * 3 * 4\n"
    },
    {
      "story": 5,
      "name": "a #tag line is not escaped",
      "source": "#alpha #beta\ntext",
      "expected": "#alpha #beta\ntext\n"
    },
    {
      "story": 5,
      "name": "a # that would be a heading is escaped",
      "source": "\\# not a heading",
      "expected": "\\# not a heading\n"
    },
    {
      "story": 5,
      "name": "#5 and C# are text",
      "source": "#5 in C#",
      "expected": "#5 in C#\n"
    },
    {
      "story": 5,
      "name": "1. that would be a list is escaped",
      "source": "1\\. not a list",
      "expected": "1\\. not a list\n"
    },
    {
      "story": 5,
      "name": "a heading's closing hashes are escaped only when they would close",
      "source": "# a \\#\n\n# C#",
      "expected": "# a \\#\n\n# C#\n"
    },
    {
      "story": 6,
      "name": "bare URLs and www links are written bare",
      "source": "see https://example.com/a_b and www.example.com.",
      "expected": "see https://example.com/a_b and www.example.com.\n"
    },
    {
      "story": 6,
      "name": "a scheme with nothing after it is not a link and needs no escape",
      "source": "not https:// ",
      "expected": "not https://\n"
    },
    {
      "story": 6,
      "name": "an autolink is written bare",
      "source": "<https://example.com> and <a@b.co>",
      "expected": "https://example.com and a@b.co\n"
    },
    {
      "story": 6,
      "name": "a URL that letters would extend stays an autolink",
      "source": "[https://a.com](https://a.com)b",
      "expected": "<https://a.com>b\n"
    },
    {
      "story": 6,
      "name": "an autolink whose URL holds a backslash is bare too: the literal keeps it",
      "source": "<https://a.com/a\\.b>",
      "expected": "https://a.com/a\\.b\n"
    },
    {
      "story": 6,
      "name": "a link with an empty label is written as its URL",
      "source": "[](https://x.com/a)",
      "expected": "https://x.com/a\n"
    },
    {
      "story": 7,
      "name": "single newlines stay single newlines",
      "source": "line one\nline two\nline three",
      "expected": "line one\nline two\nline three\n"
    },
    {
      "story": 7,
      "name": "whitespace at the end of a line is not written",
      "source": "one \ntwo\t\nthree",
      "expected": "one\ntwo\nthree\n"
    },
    {
      "story": 7,
      "name": "an old two-space hard break is written as a backslash",
      "source": "one  \ntwo",
      "expected": "one\\\ntwo\n"
    },
    {
      "story": 7,
      "name": "a backslash hard break stays",
      "source": "one\\\ntwo",
      "expected": "one\\\ntwo\n"
    },
    {
      "story": 7,
      "name": "a hard break in a setext heading is a space",
      "source": "a  \nb\n===\n\nc\nd\n---",
      "expected": "# a b\n\n## c d\n"
    },
    {
      "story": 7,
      "name": "a newline before inline HTML stays a newline",
      "source": "Press\n<kbd>Ctrl</kbd> now",
      "expected": "Press\n<kbd>Ctrl</kbd> now\n"
    },
    {
      "story": 7,
      "name": "bold across a line break is one run",
      "source": "**a\nb** and **c**\n**d**",
      "expected": "**a\nb** and **c**\n**d**\n"
    },
    {
      "story": 8,
      "name": "N empty paragraphs between blocks are N+1 blank lines",
      "source": "a\n\n\n\nb\n\n\nc",
      "expected": "a\n\n\n\nb\n\n\nc\n"
    },
    {
      "story": 8,
      "name": "blank lines before the first block are kept",
      "source": "\n\n# h",
      "expected": "\n\n# h\n"
    },
    {
      "story": 8,
      "name": "an older build's <br /> line is one empty paragraph",
      "source": "a\n\n<br />\n\nb",
      "expected": "a\n\n\nb\n"
    },
    {
      "story": 8,
      "name": "an inline <br> beside text stays",
      "source": "a <br> b",
      "expected": "a <br> b\n"
    },
    {
      "story": 8,
      "name": "empty paragraphs inside a quote",
      "source": "> a\n>\n>\n> b",
      "expected": "> a\n>\n>\n> b\n"
    },
    {
      "story": 8,
      "name": "an empty paragraph inside a list item, after its first paragraph",
      "source": "- a\n\n\n  b\n- c",
      "expected": "- a\n\n\n  b\n- c\n"
    },
    {
      "story": 9,
      "name": "a tight list stays tight",
      "source": "- a\n- b\n  - c",
      "expected": "- a\n- b\n  - c\n"
    },
    {
      "story": 9,
      "name": "a loose list stays loose",
      "source": "- a\n\n- b",
      "expected": "- a\n\n- b\n"
    },
    {
      "story": 9,
      "name": "a loose item inside a tight list keeps its blank line",
      "source": "- a\n- b\n\n  c\n- d",
      "expected": "- a\n- b\n\n  c\n- d\n"
    },
    {
      "story": 9,
      "name": "two paragraphs in a tight item are written loose: no tight spelling keeps them two (Backspace at a nested item's start)",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "label": "•",
                  "listType": "bullet",
                  "spread": false,
                  "checked": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "a"
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "b"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "- a\n\n  b\n"
    },
    {
      "story": 9,
      "name": "a tight item made loose by two paragraphs spaces all its blocks",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "label": "•",
                  "listType": "bullet",
                  "spread": false,
                  "checked": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "a"
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "b"
                      }
                    ]
                  },
                  {
                    "type": "bullet_list",
                    "attrs": {
                      "spread": false
                    },
                    "content": [
                      {
                        "type": "list_item",
                        "attrs": {
                          "label": "•",
                          "listType": "bullet",
                          "spread": false,
                          "checked": null
                        },
                        "content": [
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "text",
                                "text": "c"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "- a\n\n  b\n\n  - c\n"
    },
    {
      "story": 9,
      "name": "two paragraphs in a tight nested item loosen that item only",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "label": "•",
                  "listType": "bullet",
                  "spread": false,
                  "checked": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "a"
                      }
                    ]
                  },
                  {
                    "type": "bullet_list",
                    "attrs": {
                      "spread": false
                    },
                    "content": [
                      {
                        "type": "list_item",
                        "attrs": {
                          "label": "•",
                          "listType": "bullet",
                          "spread": false,
                          "checked": null
                        },
                        "content": [
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "text",
                                "text": "x"
                              }
                            ]
                          },
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "text",
                                "text": "b"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "- a\n  - x\n\n    b\n"
    },
    {
      "story": 9,
      "name": "an empty paragraph between two blocks of a tight item makes it loose",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "label": "•",
                  "listType": "bullet",
                  "spread": false,
                  "checked": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "a"
                      }
                    ]
                  },
                  {
                    "type": "bullet_list",
                    "attrs": {
                      "spread": false
                    },
                    "content": [
                      {
                        "type": "list_item",
                        "attrs": {
                          "label": "•",
                          "listType": "bullet",
                          "spread": false,
                          "checked": null
                        },
                        "content": [
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "text",
                                "text": "c"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "paragraph"
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "b"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "- a\n\n  - c\n\n\n  b\n"
    },
    {
      "story": 10,
      "name": "ordered items are numbered from the start",
      "source": "1. a\n1. b\n1. c\n\n3) x\n7) y",
      "expected": "1. a\n2. b\n3. c\n\n3) x\n4) y\n"
    },
    {
      "story": 10,
      "name": "1) numbering is written 1.",
      "source": "1) a\n2) b",
      "expected": "1. a\n2. b\n"
    },
    {
      "story": 11,
      "name": "a nested list is indented by its parent's marker width",
      "source": "* a\n    * b\n\ntext\n\n10. x\n    - y\n\ntext\n\n1. p\n   1. q",
      "expected": "- a\n  - b\n\ntext\n\n10. x\n    - y\n\ntext\n\n1. p\n   1. q\n"
    },
    {
      "story": 12,
      "name": "task items, an empty task item and an uppercase X",
      "source": "- [ ] todo\n- [ ]\n* [X] done",
      "expected": "- [ ] todo\n- [ ]\n\n* [x] done\n"
    },
    {
      "story": 12,
      "name": "an empty task item with a nested list",
      "source": "- [ ]\n  - b",
      "expected": "- [ ]\n  - b\n"
    },
    {
      "story": 12,
      "name": "a list item that starts with a block writes it on the marker line",
      "source": "* > quote\n*\n  # heading",
      "expected": "- > quote\n- # heading\n"
    },
    {
      "story": 13,
      "name": "a fence is one longer than the longest fence inside",
      "source": "````\n```\ninner\n```\n````",
      "expected": "````\n```\ninner\n```\n````\n"
    },
    {
      "story": 13,
      "name": "tilde and indented code are written with backticks",
      "source": "~~~js\nx = 1\n~~~\n\n    indented",
      "expected": "```js\nx = 1\n```\n\n```\nindented\n```\n"
    },
    {
      "story": 13,
      "name": "an empty fence",
      "source": "```\n```",
      "expected": "```\n```\n"
    },
    {
      "story": 13,
      "name": "inline code fences and padding",
      "source": "`a` and `` b`c `` and `` `d `` and ``  e  ``",
      "expected": "`a` and ``b`c`` and `` `d `` and `  e  `\n"
    },
    {
      "story": 14,
      "name": "table cells get one space each side, no column padding",
      "source": "|a|b|\n|-|-|\n|1|2|\n|  long cell  |x|",
      "expected": "| a | b |\n| --- | --- |\n| 1 | 2 |\n| long cell | x |\n"
    },
    {
      "story": 14,
      "name": "a pipe in a cell is \\|, in text and code",
      "source": "| a \\| b | `c\\|d` |\n| --- | --- |",
      "expected": "| a \\| b | `c\\|d` |\n| --- | --- |\n"
    },
    {
      "story": 14,
      "name": "a line break in a cell is <br>",
      "source": "| a<br>b |\n| --- |",
      "expected": "| a<br>b |\n| --- |\n"
    },
    {
      "story": 14,
      "name": "a ragged row is padded at the end",
      "source": "| a | b |\n| --- | --- |\n| 1 |",
      "expected": "| a | b |\n| --- | --- |\n| 1 |  |\n"
    },
    {
      "story": 14,
      "name": "a table with no body rows",
      "source": "|a|\n|-|",
      "expected": "| a |\n| --- |\n"
    },
    {
      "story": 15,
      "name": "alignments: unset ---, left :--, center :-:, right --:",
      "source": "| a | b | c | d |\n|---|:--|:-:|--:|\n| 1 | 2 | 3 | 4 |",
      "expected": "| a | b | c | d |\n| --- | :-- | :-: | --: |\n| 1 | 2 | 3 | 4 |\n"
    },
    {
      "story": 16,
      "name": "front matter is written back byte for byte",
      "source": "---\ntags: [a, b]\ntitle: \"x*y*\"  \n\nnested:\n  - _z_\n---\n\nbody _x_",
      "expected": "---\ntags: [a, b]\ntitle: \"x*y*\"  \n\nnested:\n  - _z_\n---\n\nbody *x*\n"
    },
    {
      "story": 16,
      "name": "a note of only front matter",
      "source": "---\na: 1\n---",
      "expected": "---\na: 1\n---\n"
    },
    {
      "story": 17,
      "name": "wikilinks keep their raw target",
      "source": "[[Projects/Road map]] and [[a_b*c*]] and ![[embed]]",
      "expected": "[[Projects/Road map]] and [[a_b*c*]] and ![[embed]]\n"
    },
    {
      "story": 17,
      "name": "a pipe in a wikilink in a cell is \\|",
      "source": "| [[a\\|b]] |\n| --- |",
      "expected": "| [[a\\|b]] |\n| --- |\n"
    },
    {
      "story": 17,
      "name": "text that looks like a wikilink keeps its escape",
      "source": "\\[[not a link]]",
      "expected": "\\[[not a link]]\n"
    },
    {
      "story": 17,
      "name": "two escapes before [[ come back as one, on the opener",
      "source": "\\[\\[x]] **b**",
      "expected": "\\[[x]] **b**\n"
    },
    {
      "story": 18,
      "name": "images keep their syntax and never gain a title",
      "source": "![](image-1.png) ![alt](b.png \"T\") ![a](<c d.png>)",
      "expected": "![](image-1.png) ![alt](b.png \"T\") ![a](<c d.png>)\n"
    },
    {
      "story": 19,
      "name": "inline and block HTML are kept exactly",
      "source": "Press <kbd>Ctrl</kbd> <span class=\"x\">y</span>\n\n<div>\n  x\n</div>",
      "expected": "Press <kbd>Ctrl</kbd> <span class=\"x\">y</span>\n\n<div>\n  x\n</div>\n"
    },
    {
      "story": 19,
      "name": "a multi-line inline tag keeps its indent",
      "source": "a <span\n       b='1'>x</span>",
      "expected": "a <span\n       b='1'>x</span>\n"
    },
    {
      "story": 20,
      "name": "an unused link reference definition is kept",
      "source": "[unused]: https://x.com \"T\"\n\ntext",
      "expected": "[unused]: https://x.com \"T\"\n\ntext\n"
    },
    {
      "story": 20,
      "name": "a used definition moves into its link",
      "source": "[a][x]\n\n[x]: /u",
      "expected": "[a](/u)\n"
    },
    {
      "story": 20,
      "name": "text that would use a kept definition keeps its escape",
      "source": "\\[x]\n\n[x]: /u",
      "expected": "\\[x]\n\n[x]: /u\n"
    },
    {
      "story": 21,
      "name": "trailing empty paragraphs are not written",
      "source": "a\n\n\n\n\n",
      "expected": "a\n"
    },
    {
      "story": 22,
      "name": "CRLF and CR are written LF, code and front matter included",
      "source": "---\r\na: 1\r\n---\r\n\r\nx\r\ny\r\n\r\n```\r\nc\r\n```",
      "expected": "---\na: 1\n---\n\nx\ny\n\n```\nc\n```\n"
    },
    {
      "story": 22,
      "name": "a lone CR is a line break",
      "source": "a\rb",
      "expected": "a\nb\n"
    },
    {
      "name": "two touching lists alternate - and *",
      "source": "- a\n* b\n- c",
      "expected": "- a\n\n* b\n\n- c\n"
    },
    {
      "name": "lists separated only by an empty paragraph alternate",
      "source": "- a\n\n\n* b\n\n\n1. c\n\n\n1) d",
      "expected": "- a\n\n\n* b\n\n\n1. c\n\n\n1) d\n"
    },
    {
      "name": "a list after a paragraph uses the default marker again",
      "source": "* a\n\ntext\n\n+ b",
      "expected": "- a\n\ntext\n\n- b\n"
    },
    {
      "name": "bold whose edge is punctuation next to a letter keeps flanking",
      "source": "**Note:**&#x62;ar",
      "expected": "**Note:**&#x62;ar\n"
    },
    {
