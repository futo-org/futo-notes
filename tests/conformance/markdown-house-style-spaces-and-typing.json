{
  "description": "The editor's markdown house style (docs/spec/editor.md \"Markdown house style\", #266): what a save writes for a note, as hand-reviewed {source, expected} pairs. `source` is read with the app's own parser; `doc` instead gives an editor-made document no file could produce (ProseMirror toJSON shape). Every case also asserts that `expected` reads back as the same document and writes itself again unchanged. TypeScript only: the serializer has no Rust consumer. Runner: src/features/editor/milkdown/markdownHouseStyle.test.ts.",
  "cases": [
    {
      "name": "spaces typed at the start or the end of a line are not written",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "  indented "
              },
              {
                "type": "hardbreak",
                "attrs": {
                  "isInline": true
                }
              },
              {
                "type": "text",
                "text": "\tnext  "
              }
            ]
          }
        ]
      },
      "expected": "indented\nnext\n"
    },
    {
      "name": "bold that starts with spaces at a line's start is written without them, never with a reference",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "  a",
                "marks": [
                  {
                    "type": "strong",
                    "attrs": {
                      "marker": "*"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "**a**\n"
    },
    {
      "name": "a heading's and a cell's leading spaces are not written",
      "source": "# &#x20;h\n\n| &#x20;x | **&#x20;y** |\n| --- | --- |",
      "expected": "# h\n\n| x | **y** |\n| --- | --- |\n"
    },
    {
      "name": "a space after formatting that opens mid-line stays a reference: that is flanking, not a line's start",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "x "
              },
              {
                "type": "text",
                "text": " a",
                "marks": [
                  {
                    "type": "strong",
                    "attrs": {
                      "marker": "*"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "x **&#x20;a**\n"
    },
    {
      "name": "a link or code span at a line's start keeps its leading space: the parser keeps it there",
      "source": "[ a](u) and\n[ b](u)\n\n` c`",
      "expected": "[ a](u) and\n[ b](u)\n\n` c`\n"
    },
    {
      "story": 12,
      "name": "spaces after a task item's [ ] are written as typed: they follow the checkbox on the line, and the parser keeps them",
      "source": "- [ ]  x\n- [x]   **a**\n  b",
      "expected": "- [ ]  x\n- [x]   **a**\n  b\n"
    },
    {
      "name": "a link whose text starts with a space keeps a plain space: after the bracket it is not the line's start",
      "source": "[ _a_](u)",
      "expected": "[ *a*](u)\n"
    },
    {
      "name": "text right after an opening mark is not at the line's start: 1. and # stay bare",
      "source": "**1. not a list** and *# not a heading*",
      "expected": "**1. not a list** and *# not a heading*\n"
    },
    {
      "name": "a line break at the end of a paragraph is not written",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "a"
              },
              {
                "type": "hardbreak",
                "attrs": {
                  "isInline": true
                }
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "b"
              }
            ]
          }
        ]
      },
      "expected": "a\n\nb\n"
    },
    {
      "name": "typed text that would read as syntax is escaped",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "# not a heading"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "1. not a list"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "- not a bullet"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "*not italic* and <b>"
              }
            ]
          }
        ]
      },
      "expected": "\\# not a heading\n\n1\\. not a list\n\n\\- not a bullet\n\n\\*not italic* and \\<b>\n"
    },
    {
      "name": "bold typed against a letter after punctuation",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "marks": [
                  {
                    "type": "strong",
                    "attrs": {
                      "marker": "*"
                    }
                  }
                ],
                "text": "Note:"
              },
              {
                "type": "text",
                "text": "bar"
              }
            ]
          }
        ]
      },
      "expected": "**Note:**&#x62;ar\n"
    },
    {
      "name": "bold and italic that overlap",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "marks": [
                  {
                    "type": "strong",
                    "attrs": {
                      "marker": "*"
                    }
                  }
                ],
                "text": "a"
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "emphasis",
                    "attrs": {
                      "marker": "*"
                    }
                  },
                  {
                    "type": "strong",
                    "attrs": {
                      "marker": "*"
                    }
                  }
                ],
                "text": "b"
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "emphasis",
                    "attrs": {
                      "marker": "*"
                    }
                  }
                ],
                "text": "c"
              }
            ]
          }
        ]
      },
      "expected": "**a*b****c*\n"
    },
    {
      "name": "an empty task item made in the editor",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "label": "•",
                  "listType": "bullet",
                  "spread": false,
                  "checked": false
                },
                "content": [
                  {
                    "type": "paragraph"
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "- [ ]\n"
    },
    {
      "name": "two touching lists made in the editor",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "spread": false,
                  "checked": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "a"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph"
          },
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "spread": false,
                  "checked": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "b"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "- a\n\n\n* b\n"
    },
    {
      "name": "in a quote, a tight list is followed directly by a list or a quote (a blank > line would make it loose)",
      "source": "> 1. a\n> - b\n> > q",
      "expected": "> 1. a\n> - b\n> > q\n"
    },
    {
      "name": "in a quote, a loose list keeps the blank line before the next list",
      "source": "> 1. a\n>\n> - b",
      "expected": "> 1. a\n>\n> - b\n"
    },
    {
      "name": "in a quote, a tight item's paragraph after its nested list keeps the blank line it needs",
      "source": "> - a\n>   - b\n>\n>   c",
      "expected": "> - a\n>   - b\n>\n>   c\n"
    },
    {
      "name": "a closing tag on the line after a list item is its own HTML block after the list",
      "source": "+ a\n</grid>",
      "expected": "- a\n\n</grid>\n"
    },
    {
      "name": "an HTML block's indentation before its first tag is not written",
      "source": "- x\n    - y\n    <details>\n         <summary>C</summary>",
      "expected": "- x\n  - y\n  <details>\n         <summary>C</summary>\n"
    },
    {
      "name": "a destination with < inside stays bare",
      "source": "[a](x.md#<c-i>-y)",
      "expected": "[a](x.md#<c-i>-y)\n"
    },
    {
      "name": "a reference that would decode keeps its escape, one that would not stays bare",
      "source": "| &amp;#2600; | &amp;#1F600; |\n| --- | --- |",
      "expected": "| \\&#2600; | &#1F600; |\n| --- | --- |\n"
    },
    {
      "name": "a literal backslash at the end of a line is escaped (it would be a hard break)",
      "source": "a \\\\\nb",
      "expected": "a \\\\\nb\n"
    },
    {
      "name": "HTML that followed a tight item's paragraph on a lazy line stays lazy",
      "source": "+ a\n</grid>\n\nnote:",
      "expected": "- a\n</grid>\n\nnote:\n"
    },
    {
      "story": 14,
      "name": "a pipe in a link or image destination or title inside a cell is \\|",
      "source": "| [x](u?a=\\|b \"t\\|u\") | ![i](p\\|q.png) |\n| --- | --- |",
      "expected": "| [x](u?a=\\|b \"t\\|u\") | ![i](p\\|q.png) |\n| --- | --- |\n"
    }
  ]
}
