      "name": "an empty paragraph between two blocks of a tight item makes it loose",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "label": "•",
                  "listType": "bullet",
                  "spread": false,
                  "checked": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
