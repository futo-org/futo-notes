{
  "description": "The editor's markdown house style (docs/spec/editor.md \"Markdown house style\", #266): what a save writes for a note, as hand-reviewed {source, expected} pairs. `source` is read with the app's own parser; `doc` instead gives an editor-made document no file could produce (ProseMirror toJSON shape). Every case also asserts that `expected` reads back as the same document and writes itself again unchanged. TypeScript only: the serializer has no Rust consumer. Runner: src/features/editor/milkdown/markdownHouseStyle.test.ts.",
  "cases": [
    {
      "story": 9,
      "name": "a tight list stays tight",
      "source": "- a\n- b\n  - c",
      "expected": "- a\n- b\n  - c\n"
    },
    {
      "story": 9,
      "name": "a loose list stays loose",
      "source": "- a\n\n- b",
      "expected": "- a\n\n- b\n"
    },
    {
      "story": 9,
      "name": "a loose item inside a tight list keeps its blank line",
      "source": "- a\n- b\n\n  c\n- d",
      "expected": "- a\n- b\n\n  c\n- d\n"
    },
    {
      "story": 9,
      "name": "two paragraphs in a tight item are written tight, as two lines of one paragraph (Backspace at a nested item's start)",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "label": "•",
                  "listType": "bullet",
                  "spread": false,
                  "checked": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "a"
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "b"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "- a\n  b\n"
    },
    {
      "story": 9,
      "name": "two paragraphs and a nested list in a tight item stay tight",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "label": "•",
                  "listType": "bullet",
                  "spread": false,
                  "checked": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "a"
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "b"
                      }
                    ]
                  },
                  {
                    "type": "bullet_list",
                    "attrs": {
                      "spread": false
                    },
                    "content": [
                      {
                        "type": "list_item",
                        "attrs": {
                          "label": "•",
                          "listType": "bullet",
                          "spread": false,
                          "checked": null
                        },
                        "content": [
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "text",
                                "text": "c"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "- a\n  b\n  - c\n"
    },
    {
      "story": 9,
      "name": "two paragraphs in a tight nested item are two lines of one paragraph",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "label": "•",
                  "listType": "bullet",
                  "spread": false,
                  "checked": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "a"
                      }
                    ]
                  },
                  {
                    "type": "bullet_list",
                    "attrs": {
                      "spread": false
                    },
                    "content": [
                      {
                        "type": "list_item",
                        "attrs": {
                          "label": "•",
                          "listType": "bullet",
                          "spread": false,
                          "checked": null
                        },
                        "content": [
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "text",
                                "text": "x"
                              }
                            ]
                          },
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "text",
                                "text": "b"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "- a\n  - x\n    b\n"
    },
    {
      "name": "the joined second line keeps the escape it needs: 1. there would start a list",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "label": "•",
                  "listType": "bullet",
                  "spread": false,
                  "checked": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "a"
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "1. b"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "- a\n  1\\. b\n"
    },
    {
      "name": "a paragraph joined to the one before keeps its own empty line: the item turns loose there",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "label": "•",
                  "listType": "bullet",
                  "spread": false,
                  "checked": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "a"
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "b"
                      },
                      {
                        "type": "hardbreak",
                        "attrs": {
                          "isInline": true
                        }
                      },
                      {
                        "type": "hardbreak",
                        "attrs": {
                          "isInline": true
                        }
                      },
                      {
                        "type": "text",
                        "text": "c"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "- a\n  b\n\n  c\n"
    },
    {
      "name": "a paragraph after an HTML block in a tight item keeps its blank line: the block would take the line",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "bullet_list",
            "attrs": {
              "spread": false
            },
            "content": [
              {
                "type": "list_item",
                "attrs": {
                  "label": "•",
                  "listType": "bullet",
                  "spread": false,
                  "checked": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "html",
                        "attrs": {
                          "value": "<div>x</div>"
                        }
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "b"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "- <div>x</div>\n\n  b\n"
    },
    {
